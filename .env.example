 # ---- Runtime ----
APP_NAME=Legal Buddy
ENVIRONMENT=development
DEBUG=true
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=sqlite:///./legal_buddy.db

# ---- TinyFish (https://docs.tinyfish.ai) ----
# Create a key at your TinyFish dashboard / agent.tinyfish.ai api-keys page.
TINYFISH_API_KEY=
# Verified defaults — override only if TinyFish documents a different host.
TINYFISH_SEARCH_ENDPOINT=https://api.search.tinyfish.ai
TINYFISH_FETCH_ENDPOINT=https://api.fetch.tinyfish.ai
TINYFISH_TIMEOUT_SECONDS=30
TINYFISH_SEARCH_LIMIT=8
TINYFISH_FETCH_LIMIT=5

# ---- Google Gemini ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_EXCERPT_CHARS=9000

# ---- Limits ----
MAX_UPLOAD_BYTES=10485760
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
USAGE_DAILY_SEARCH_LIMIT_FREE=10
USAGE_DAILY_FETCH_LIMIT_FREE=25
USAGE_DAILY_SEARCH_LIMIT_PRO=100
USAGE_DAILY_FETCH_LIMIT_PRO=500
SESSION_RETENTION_DAYS=30

# ---- Frontend (frontend/.env.local) ----
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000